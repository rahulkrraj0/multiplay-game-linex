# Replace example secrets with unique random values before starting.
POSTGRES_USER=multiplay
POSTGRES_DB=multiplay
POSTGRES_PASSWORD=replace_with_random_alphanumeric_secret

# Local Docker Desktop defaults. Set both URLs to your HTTPS domain for public hosting.
VITE_PUBLIC_SITE_URL=
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Required for production. Obtain a dedicated app client from the auth broker.
# Do not use the shared live-preview client for a deployed site.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# TURN relay — required for players on different networks (4G vs Wi-Fi, mobile data, etc.)
#
# TURN_HOSTNAME    : your server's public domain or IP (e.g. gameslord.online or 1.2.3.4)
# TURN_EXTERNAL_IP : your server's public IPv4 address (find with: curl -4 ifconfig.me)
# TURN_BIND_IP     : leave blank (defaults to 0.0.0.0 = listen on all interfaces)
#                    Set to a specific IP to restrict which interface coturn binds to.
# TURN_SHARED_SECRET: a long random secret shared between the app and coturn (must match)
# TURN_URLS        : the TURN URL(s) the browser uses to reach coturn
#                    For a domain:  turn:gameslord.online:3478?transport=udp,turn:gameslord.online:3478?transport=tcp
#                    For a bare IP: turn:1.2.3.4:3478?transport=udp,turn:1.2.3.4:3478?transport=tcp
#
# Firewall rules required on your server:
#   ufw allow 3478/tcp && ufw allow 3478/udp && ufw allow 49160:49200/udp
#
TURN_HOSTNAME=gameslord.online
TURN_EXTERNAL_IP=your_server_public_ipv4
TURN_BIND_IP=
TURN_URLS=turn:gameslord.online:3478?transport=udp,turn:gameslord.online:3478?transport=tcp
TURN_SHARED_SECRET=replace_with_a_different_random_secret

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Configure > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
